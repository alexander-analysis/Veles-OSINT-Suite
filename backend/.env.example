# Copy to backend/.env and fill in.  Never commit .env.
DATABASE_URL=sqlite:///./veles.db
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated allowed origins for CORS ("*" for any)
CORS_ORIGINS=*
# Set to false to run the API without the background bots (e.g. tests, debugging)
SCHEDULER_ENABLED=true

# Exchange APIs (public market data works without keys; keys raise rate limits)
BINANCE_API_KEY=your_key_here
KRAKEN_API_KEY=your_key_here
COINBASE_API_KEY=your_key_here

# Maritime APIs
MARINETRAFFIC_API_KEY=your_key_here

# Cloudflare Tunnel (only needed for token-based `cloudflared service install`)
CLOUDFLARE_TOKEN=your_token_here
