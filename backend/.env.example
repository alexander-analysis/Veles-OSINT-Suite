# Copy to backend/.env and fill in.  Never commit .env.
DATABASE_URL=sqlite:///./veles.db
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated allowed origins for CORS ("*" for any)
CORS_ORIGINS=*
# Set to false to run the API without the background bots (e.g. tests, debugging)
SCHEDULER_ENABLED=true

# Exchange APIs (public market data works without keys; keys raise rate limits)
BINANCE_API_KEY=your_key_here
KRAKEN_API_KEY=your_key_here
COINBASE_API_KEY=your_key_here

# Maritime APIs (all optional - Digitraffic (Finland) needs no key and is on by default)
MARINETRAFFIC_API_KEY=your_key_here
# aisstream.io - free key, global coverage via WebSocket (https://aisstream.io)
AISSTREAM_API_KEY=your_key_here
# Blockchain tracker: optional alternative Ethereum JSON-RPC endpoint (default: PublicNode, keyless)
ETHEREUM_RPC_URL=
# Corporate intelligence: contact e-mail the SEC asks for in EDGAR requests (any address you control)
EDGAR_CONTACT_EMAIL=
# AISHub - free membership username (you must contribute a feed)
AISHUB_USERNAME=your_username_here
# OpenWeatherMap - environmental context on vessel pages
OPENWEATHERMAP_API_KEY=your_key_here
# Local RTL-SDR: rtl_ais / AIS-catcher sending NMEA over UDP to this port
RTL_AIS_UDP_PORT=10110

# Cloudflare Tunnel (only needed for token-based `cloudflared service install`)
CLOUDFLARE_TOKEN=your_token_here

# Optional: require this token on every /api request (X-API-Key header). Leave empty on a trusted network.
VELES_API_TOKEN=

# Optional notifications: Slack-compatible incoming webhook and/or SMTP
NOTIFY_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
